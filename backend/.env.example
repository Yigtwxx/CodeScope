# Copy to backend/.env and adjust. Every value below is optional; the
# defaults shown are what CodeScope uses when the variable is unset.

# --- Server ---
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Filesystem sandbox ---
# Every path the API may read must live under this directory.
# Defaults to your home directory.
# WORKSPACE_ROOT=C:\Users\you\Projects

# --- Vector store ---
# CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION_NAME=codescope_codebase
# Wipe the index on every server start.
RESET_DB_ON_STARTUP=false

# --- Embeddings ---
# Changing this invalidates the index; CodeScope discards it and asks you to
# re-index rather than mixing vectors from two models.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
# The e5 family requires these prefixes. Blank them for a model that takes none
# (for example sentence-transformers/all-MiniLM-L6-v2).
EMBEDDING_QUERY_PROMPT="query: "
EMBEDDING_DOCUMENT_PROMPT="passage: "
# Only enable for a model you have decided to trust: it executes code shipped
# in that model's repository.
EMBEDDING_TRUST_REMOTE_CODE=false
# auto resolves to cuda -> mps -> cpu. Use cuda / mps / cpu to pin it.
EMBEDDING_DEVICE=auto

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
RETRIEVAL_TOP_K=8
SEMANTIC_WEIGHT=0.7
BM25_WEIGHT=0.3

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.1
# Ollama's own default is a 4096-token window and an unbounded reply, which
# truncates grounded answers mid-sentence. Raise NUM_CTX for bigger contexts if
# your GPU has the memory.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
